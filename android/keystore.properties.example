# Copy this file to android/keystore.properties (git ignores that name) and
# fill in the real values. Never commit the real file or the .jks key.
#
# storeFile: full path to the upload key. Keep it OUTSIDE this repo, and
# back it up somewhere safe (password manager, or an encrypted USB stick).
# Use forward slashes, even on Windows.
storeFile=C:/Users/LAPTOP80/true-keys/true-upload.jks
storePassword=your-keystore-password
keyAlias=true-upload
keyPassword=your-key-password
